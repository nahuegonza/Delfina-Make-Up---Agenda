# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Resend → API Keys (para mandar los mails)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Delfina Acuña Makeup <contacto@delfinamakeup.com>"
EMAIL_REPLY_TO=contacto@delfinamakeup.com

# Clave inventada por vos (cualquier texto largo) para proteger los recordatorios automáticos
CRON_SECRET=una-clave-larga-y-secreta

# Web pública (delfinamakeup.com)
NEXT_PUBLIC_WEB_URL=https://delfina-makeup.netlify.app
# Orígenes que pueden mandar consultas (separados por coma)
WEB_ORIGINS=https://delfinamakeup.com,https://www.delfinamakeup.com,https://delfina-makeup.netlify.app
# A dónde llegan las consultas del formulario
EMAIL_INQUIRIES_TO=contacto@delfinamakeup.com
